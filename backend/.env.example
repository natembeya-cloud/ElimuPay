# Copy this file to .env and adjust as needed.

# Port the API listens on. On Render/Railway/Fly this is set for you
# automatically and this value is ignored — only used for local dev.
PORT=4000

# Comma-separated list of frontend origins allowed to call this API.
# Use * only for local development.
CORS_ORIGIN=*

# Secret used to sign admin login tokens. Set a long random value in production.
JWT_SECRET=elimupay-dev-secret-change-me

# --- Daraja (M-Pesa) credentials — required only when routes/payments.js
# is switched from the mock STK/callback handlers to real Daraja calls. ---
# DARAJA_CONSUMER_KEY=
# DARAJA_CONSUMER_SECRET=
# DARAJA_SHORTCODE=
# DARAJA_PASSKEY=
# DARAJA_CALLBACK_URL=https://your-domain.co.ke/api/mpesa/callback
